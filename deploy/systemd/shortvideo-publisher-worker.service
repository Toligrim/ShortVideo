[Unit]
Description=ShortVideo social publishing worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_DIR@
EnvironmentFile=%h/.config/shortvideo/publisher.env
UMask=0077
ExecStart=@PYTHON@ @PROJECT_DIR@/tools/publish.py worker
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
