# Replace every placeholder outside the repository; keep this file non-secret.
SHORTVIDEO_PUBLISH_STATE_DIR=/home/USER/.local/share/shortvideo/publisher
SHORTVIDEO_FFMPEG_BIN=ffmpeg
SHORTVIDEO_FFPROBE_BIN=ffprobe

TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
TELEGRAM_ALLOWED_CHAT_ID=REPLACE_WITH_CHAT_ID
TELEGRAM_ALLOWED_USER_ID=REPLACE_WITH_USER_ID

# Use this file OR the two direct client variables below, never both.
SHORTVIDEO_YOUTUBE_CLIENT_SECRETS_FILE=/home/USER/.local/share/shortvideo/secrets/youtube-client.json
# SHORTVIDEO_YOUTUBE_CLIENT_ID=REPLACE_WITH_CLIENT_ID
# SHORTVIDEO_YOUTUBE_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
SHORTVIDEO_YOUTUBE_TOKEN_FILE=/home/USER/.local/share/shortvideo/secrets/youtube-token.json

SHORTVIDEO_INSTAGRAM_USER_ID=REPLACE_WITH_PROFESSIONAL_ACCOUNT_ID
SHORTVIDEO_INSTAGRAM_API_VERSION=REPLACE_WITH_CURRENT_VXX_0
SHORTVIDEO_INSTAGRAM_ACCESS_TOKEN_FILE=/home/USER/.local/share/shortvideo/secrets/instagram-token

SHORTVIDEO_R2_ACCOUNT_ID=REPLACE_WITH_32_HEX_ACCOUNT_ID
SHORTVIDEO_R2_BUCKET=REPLACE_WITH_BUCKET
SHORTVIDEO_R2_ACCESS_KEY_ID=REPLACE_WITH_SCOPED_ACCESS_KEY
SHORTVIDEO_R2_SECRET_ACCESS_KEY=REPLACE_WITH_SCOPED_SECRET
SHORTVIDEO_R2_TTL=900
